{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft OpenStudio SI evaluation-run 0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "host": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "sandbox": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        }
      },
      "required": [
        "model"
      ]
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": {
          "const": "deepeval"
        },
        "provider": {
          "enum": [
            "openai",
            "azure-openai",
            "anthropic",
            "gemini",
            "ollama",
            "openai-compatible"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "deployment_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "geval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "strict_mode": {
              "type": "boolean"
            },
            "top_logprobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": []
        }
      },
      "required": [
        "framework",
        "provider",
        "model"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "ollama"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "api_key_env"
              ]
            }
          },
          "else": {
            "required": [
              "api_key_env"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "azure-openai"
              }
            }
          },
          "then": {
            "required": [
              "base_url",
              "deployment_name",
              "api_version"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "deployment_name"
                  ]
                },
                {
                  "required": [
                    "api_version"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "openai-compatible"
              }
            }
          },
          "then": {
            "required": [
              "base_url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "gemini"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "base_url"
              ]
            }
          }
        }
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "arms": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plugins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "plugins"
        ]
      }
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 7200
        },
        "judge_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "run_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_trace_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "max_evidence_chars": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1000000
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "host",
    "agent",
    "plugins"
  ]
}
