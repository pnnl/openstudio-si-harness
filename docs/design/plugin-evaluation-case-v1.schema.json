{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed OpenStudio SI plugin agent evaluation case v1",
  "description": "Extends the case shape in PR #35 with a required judge rubric. Model credentials live in run configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
      },
      "uniqueItems": true
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "forbidden_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_tools_ordered": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arm_routing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "required_tools": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tool"
            }
          },
          "forbidden_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": []
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "tolerance_pct": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "name",
              "value",
              "tolerance_pct"
            ]
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_min": {
              "type": "string",
              "minLength": 1
            },
            "counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "min_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equals": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "match": {
                    "enum": [
                      "all",
                      "any"
                    ]
                  }
                },
                "required": [
                  "type",
                  "field"
                ]
              }
            }
          },
          "required": []
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
        }
      },
      "required": []
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "criterion",
              "weight"
            ]
          },
          "minItems": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "rubric",
        "threshold"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "description",
    "prompt",
    "inputs",
    "judge"
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool"
      ]
    }
  }
}
